generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum OrgRole {
  OWNER
  ADMIN
  REVIEWER
  MEMBER
}

enum BountyStatus {
  DRAFT
  OPEN
  SUBMISSIONS_CLOSED
  REVIEWING
  AWARDED
  CANCELLED
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum RewardType {
  POINTS
  USD
}

enum SubmissionStatus {
  SUBMITTED
  SHORTLISTED
  WINNER
  REJECTED
  WITHDRAWN
}

enum PayoutStatus {
  PENDING
  APPROVED
  SENT
  FAILED
  CANCELLED
}

enum PayoutProvider {
  NONE
  STRIPE
}

enum PromptEventType {
  prompt
  assistant_reply
  iteration
  note
  external_tool
}

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email     String?  @unique
  name      String?
  image     String?
  github    String?  @unique

  attempts  Attempt[]

  orgMemberships OrgMember[]
  bountySubmissions Submission[]
  submissionReviews SubmissionReview[]
  payouts Payout[]
  stats UserStats?
}

model Organization {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug      String   @unique
  name      String
  website   String?
  logoUrl   String?

  members   OrgMember[]
  bounties  Bounty[]
}

model OrgMember {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)

  org       Organization @relation(fields: [orgId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

model Challenge {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slug        String   @unique
  title       String
  description String
  difficulty  Int      @default(1)
  tags        String[]

  prompt      String
  rubric      Json?

  attempts    Attempt[]
  bounties    Bounty[]
}

model Attempt {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userId        String
  challengeId   String
  status        AttemptStatus @default(IN_PROGRESS)

  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  submissionUrl String?
  summary       String?

  scoreTotal    Int?
  score         Json?

  user          User          @relation(fields: [userId], references: [id])
  challenge      Challenge     @relation(fields: [challengeId], references: [id])
  events        PromptEvent[]
}

model PromptEvent {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())

  attemptId String
  type      PromptEventType
  text      String
  meta      Json?

  attempt   Attempt         @relation(fields: [attemptId], references: [id])

  @@index([attemptId, createdAt])
}

model Bounty {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orgId       String?
  challengeId String
  title       String
  description String

  status      BountyStatus @default(DRAFT)
  visibility  Visibility   @default(PUBLIC)

  rewardType  RewardType   @default(POINTS)
  rewardPts   Int          @default(0)
  rewardUsdCents Int?      // future
  currency    String?      // e.g. "USD"
  rewardSplits Json?       // payout splits / winner allocations

  deadline    DateTime?
  requirements Json?

  org         Organization? @relation(fields: [orgId], references: [id])
  challenge   Challenge      @relation(fields: [challengeId], references: [id])
  submissions Submission[]
  payouts     Payout[]

  @@index([status, createdAt])
  @@index([orgId, createdAt])
}

model Submission {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bountyId    String
  userId      String
  status      SubmissionStatus @default(SUBMITTED)

  repoUrl     String
  prUrl       String?
  commitSha   String?
  note        String?

  // Automated scoring (BitCode engine)
  autoScoreTotal Int?
  autoScore      Json?
  // Manual scoring / review
  manualScoreTotal Int?
  manualScore      Json?
  // Final score
  finalScoreTotal Int?
  reviewSummary   String?

  bounty      Bounty   @relation(fields: [bountyId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  reviews     SubmissionReview[]
  payouts     Payout[]

  @@index([bountyId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SubmissionReview {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissionId String
  reviewerId   String
  orgId        String?

  rubric       Json?
  scoreTotal   Int?
  comment      String
  isPublic     Boolean @default(false)

  submission   Submission @relation(fields: [submissionId], references: [id])
  reviewer     User       @relation(fields: [reviewerId], references: [id])
  org          Organization? @relation(fields: [orgId], references: [id])

  @@index([submissionId, createdAt])
  @@index([reviewerId, createdAt])
}

model Payout {
  id           String        @id @default(cuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  bountyId     String
  submissionId String?
  userId       String
  orgId        String?

  status       PayoutStatus  @default(PENDING)
  provider     PayoutProvider @default(NONE)
  amountPts    Int?          // points payout
  amountUsdCents Int?        // future
  currency     String?

  meta         Json?

  bounty       Bounty        @relation(fields: [bountyId], references: [id])
  submission   Submission?   @relation(fields: [submissionId], references: [id])
  user         User          @relation(fields: [userId], references: [id])
  org          Organization? @relation(fields: [orgId], references: [id])

  @@index([status, createdAt])
  @@index([orgId, createdAt])
  @@index([userId, createdAt])
}

model UserStats {
  userId String @id
  updatedAt DateTime @updatedAt

  // Reputation signals
  reputationPts Int @default(0)
  bountyEarnedPts Int @default(0)
  bountiesWon Int @default(0)
  submissionsCount Int @default(0)
  avgSubmissionScore Int @default(0)

  user User @relation(fields: [userId], references: [id])
}
