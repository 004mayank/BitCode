{
  "name": "bitcode",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @bitcode/db prisma generate",
    "db:migrate": "pnpm --filter @bitcode/db prisma migrate dev",
    "db:studio": "pnpm --filter @bitcode/db prisma studio",
    "seed": "pnpm --filter @bitcode/db prisma db seed"
  }
}

