# Copy this file to .env.local and fill in the values.

# PostgreSQL — same DB used by the API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bitcode

# Next.js port (must match NEXTAUTH_URL)
NEXTAUTH_URL=http://localhost:3001

# NextAuth secret — any random string works for local dev
# Generate one: openssl rand -base64 32
AUTH_SECRET=change-me-local-dev-secret
NEXTAUTH_SECRET=change-me-local-dev-secret

# GitHub OAuth App — create one at https://github.com/settings/developers
# Callback URL must be: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# API server base URL
NEXT_PUBLIC_API_BASE=http://localhost:8000
